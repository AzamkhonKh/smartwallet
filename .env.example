# ==============================================================================
# Recipe Wallet - Local Environment Configuration Template
# Copy this file to '.env' and fill in your private API keys/secrets.
# ==============================================================================

# --- AI Providers & APIs ---
# Mistral API Key (used for OCR and extraction if OCR provider is set to 'mistral')
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenRouter API Key (used for LLM processing if LLM provider is set to 'openrouter')
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ExchangeRate API Key (used to query active currency rates)
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here


# --- Firebase Configuration ---
# Firebase Storage Bucket name
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here.appspot.com

# Firebase Service Account JSON Credentials (must be minified on ONE single line)
# E.g., {"type":"service_account","project_id":"...","private_key":"..."}
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}


# --- Langfuse Connection (For Spring Boot Backend to send telemetry) ---
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...

# Backend uses this to communicate with Langfuse container inside Docker network
# Use 'http://langfuse:3000' inside Docker compose or 'http://localhost:3000' for local backend dev.
LANGFUSE_BASE_URL=http://localhost:3000 


# --- Langfuse Server Internals (For the Langfuse Container configuration) ---
# Secrets used to secure NextAuth sessions inside Langfuse
NEXTAUTH_SECRET=generate_a_random_32_character_secret_string
SALT=generate_a_random_salt_string

# public-facing URL of the Langfuse panel (e.g. your local IP or public domain)
NEXTAUTH_URL=http://localhost:3000 


# --- App-level Modes ---
# App mode: 'dev' or 'prod'. In 'dev' mode, mock processors (OCR, Storage, LLM) can be enabled.
# In 'prod' mode, mock services are strictly blocked.
RECIPEWALLET_APP_MODE=dev

# Public domain of the API backend (used for building image access links)
RECIPEWALLET_PUBLIC_DOMAIN=http://localhost:8080
